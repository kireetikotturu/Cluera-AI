# Container runtime only. Never configure these as public/frontend variables.
# Disabled until the dedicated staging host and privately rotated keys are ready.
SIGMAROUND_ACCOUNT_RELAY_ENABLED=false
SIGMAROUND_ACCOUNTS_ENABLED=true
SIGMAROUND_ACCOUNT_ORIGIN=https://cluera-ai-staging.vercel.app
NEXT_PUBLIC_SUPABASE_URL=https://dwqltsqumiwsxtkzdoaa.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SIGMAROUND_ACCOUNT_RATE_SECRET_BASE64=
# Reviewed bootstrap: infrastructure is mandatory; all provider work denied.
CLUERA_AI_BOOTSTRAP_MODE=auth-only
# After separate approved vault bootstrap, switch only this new relay to admin-vault.
CLUERA_PROVIDER_VAULT_KEYRING_BASE64=
# No legacy key import. Explicit legacy-environment mode remains compatible if selected.
SIGMAROUND_MANAGED_GEMINI_API_KEY=
SIGMAROUND_MANAGED_DEEPGRAM_API_KEY=
PORT=8080
