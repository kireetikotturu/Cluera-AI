# Container runtime only. Never configure these as public/frontend variables.
# Enter real values in the Render dashboard (Environment), never in this file.
# Step-by-step: docs/GO_LIVE_GUIDE.md (Step 4 - Render).
SIGMAROUND_ACCOUNT_RELAY_ENABLED=true
SIGMAROUND_ACCOUNTS_ENABLED=true
SIGMAROUND_ACCOUNT_ORIGIN=https://cluera-ai-staging.vercel.app
NEXT_PUBLIC_SUPABASE_URL=https://yhnqlfcgrmckhyjdxegg.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SIGMAROUND_ACCOUNT_RATE_SECRET_BASE64=
# AI provider mode. "admin-vault" uses the Gemini/Deepgram keys saved in Admin > Providers.
# Keep "auth-only" until the vault keyring below is set; "legacy-environment" reads the two MANAGED keys instead.
CLUERA_AI_BOOTSTRAP_MODE=admin-vault
# Must equal the same value in Vercel. Generate once (see the guide); never reuse the cookie/rate secrets.
CLUERA_PROVIDER_VAULT_KEYRING_BASE64=
# Optional usage metadata in Admin > Providers (only valid with admin-vault).
CLUERA_PROVIDER_TELEMETRY_ENABLED=true
# Only for CLUERA_AI_BOOTSTRAP_MODE=legacy-environment.
SIGMAROUND_MANAGED_GEMINI_API_KEY=
SIGMAROUND_MANAGED_DEEPGRAM_API_KEY=
# Payment worker (grants credits once a minute). Add this block ONLY when you turn payments on, with every
# value filled in: a half-filled Live block stops the relay from starting. Secrets equal the Vercel values.
# CLUERA_BILLING_EXTERNAL_SCHEDULER_ENABLED=true
# SIGMAROUND_BILLING_WORKER_SECRET=
# CLUERA_LIVE_OWNER_APPROVED=true
# CLUERA_LIVE_RUNTIME_ACCEPTED=true
# CLUERA_LIVE_SCHEDULER_ENABLED=true
# CLUERA_LIVE_WORKER_EPOCH=
# CLUERA_LIVE_WORKER_SECRET=
# CLUERA_LIVE_ACCOUNT_ORIGIN=https://cluera-ai-staging.vercel.app
# CLUERA_LIVE_APPROVED_ORIGIN=https://cluera-ai-staging.vercel.app
# CLUERA_LIVE_MERCHANT_DIGEST=
PORT=8080
