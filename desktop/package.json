{
  "name": "cluera-ai-desktop",
  "version": "1.0.1",
  "description": "Cluera AI account-managed Windows workspace",
  "main": "dist/main/main.js",
  "author": "Kireeti",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-dev.cjs",
    "build:code": "npm run typecheck && vite build && tsc -p tsconfig.main.json && node scripts/harden-build.cjs",
    "build": "npm run build:code",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json",
    "test": "vitest run",
    "start": "node scripts/run-electron.cjs",
    "package:win": "npm run build:code && node ../scripts/package-cluera.cjs && node ../scripts/verify-cluera-package.cjs"
  },
  "dependencies": {
    "mammoth": "^1.9.0",
    "pdf-parse": "^1.1.1",
    "sql.js": "^1.12.0",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@fontsource/dm-sans": "^5.2.6",
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "@types/node": "^22.10.2",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/sql.js": "^1.4.9",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "http-cache-semantics": "file:vendor/http-cache-semantics",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "0.35.5",
    "supabase": "^2.118.0",
    "typescript": "^5.7.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "zustand": "^5.0.2",
    "jsdom": "27.4.0"
  },
  "overrides": {
    "brace-expansion@^5.0.8": "5.0.12",
    "source-map-js": "1.2.2",
    "http-cache-semantics": "$http-cache-semantics"
  }
}
